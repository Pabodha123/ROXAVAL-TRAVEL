# Dependencies
node_modules/
**/node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output
dist/
dist-ssr/
build/
**/dist/
**/dist-ssr/
**/build/
coverage/
**/coverage/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploaded / generated runtime files (receipts, documents, images) — keep
# folder structure via .gitkeep but never commit actual uploaded content
backend/uploads/**
!backend/uploads/**/
!backend/uploads/**/.gitkeep

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Misc
*.tmp
*.temp
