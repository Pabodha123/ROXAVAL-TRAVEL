# ==========================
# Roxaval Travels Backend
# Environment Configuration (example — copy to .env and fill in real values)
# ==========================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database
MONGO_URI=
MONGO_URI_TEST=mongodb://127.0.0.1:27017/roxaval_travels_test

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Roxaval Travels <no-reply@roxavaltravels.com>"

# Company Info (used in generated PDFs)
COMPANY_NAME=Roxaval Travels
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_LOGO_PATH=src/docs/templates/logo.png

# Payments
WHATSAPP_BUSINESS_NUMBER=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SWIFT=

# File Uploads
MAX_FILE_UPLOAD_MB=5
UPLOAD_RECEIPTS_DIR=uploads/receipts
UPLOAD_DOCUMENTS_DIR=uploads/documents

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=300

# Logging
LOG_LEVEL=info
